rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // `users/{uid}` is user-writable for preferences, so it must never grant
    // access to the private paper account. Admin access is console/server managed.
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function isPublicFeedDocument(docId) {
      return docId.matches('public_meta_v2_KR_(manifest|[0-9]+)');
    }

    match /stock_analysis/{stockId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /meta_data/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // This collection is written only by the Admin SDK and contains the
    // aggregate-only allowlisted public contract (no raw price/indicator data).
    match /public_analysis_meta/{docId} {
      // The browser uses direct document reads. Keep all other documents in
      // this collection private by default, even if a future server job writes
      // an unrelated document here.
      allow get: if isPublicFeedDocument(docId) &&
        (resource.data.strategyVersion == 'V2_PUBLIC' ||
         resource.data.strategyVersion == 'V2_PUBLIC_MANIFEST');
      allow list: if false;
      allow write: if false;
    }

    match /strategy_runs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /strategy_candidates/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /target_allocations/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /rebalance_orders/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /risk_state/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /paper_order_applications/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /intraday_trade_state/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /paper_refresh_requests/{requestId} {
      // A browser can only enqueue its own request. The school server writes
      // the completed/failed state with Admin SDK credentials.
      allow create: if isAdmin() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.market == 'KR' &&
        request.resource.data.requestedByUid == request.auth.uid &&
        request.resource.data.source == 'web' &&
        request.resource.data.requestedAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /admins/{email} {
      allow get: if isSignedIn() && request.auth.token.email == email;
      allow list: if false;
      allow write: if false;
    }

    match /bot_account_snapshot/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // KOSPI/KOSDAQ comparison is an operator-only research aid. The server
    // writes a sanitized aggregate summary; no public or ordinary-user read.
    match /paper_performance_private/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /bot_trade_logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /bot_portfolio/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
