# Firebase client configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Safety gate for public hosting.
# Leave false/empty until KRX/Koscom/KIS/overseas exchange or other upstream
# market-data display rights are confirmed for the intended public/commercial use.
VITE_ENABLE_PUBLIC_LIVE_DATA=false
# Both switches must be true, after written rights review, before the browser may load real public analysis.
VITE_PUBLIC_DATA_RIGHTS_CONFIRMED=false
VITE_PUBLIC_DATA_RIGHTS_APPROVAL_REFERENCE=

# Real ad code should stay disabled until AdSense approval, ads.txt, privacy
# disclosures, and market-data rights are all ready.
VITE_ENABLE_ADSENSE=false
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_PUBLIC_SLOT_ID=
# All values below must be verified with retained, non-secret evidence before ads can load.
VITE_ADSENSE_LEGAL_REVIEW_CONFIRMED=false
VITE_ADSENSE_LEGAL_REVIEW_REFERENCE=
VITE_ADSENSE_ACCOUNT_APPROVED=false
VITE_ADSENSE_ADS_TXT_VERIFIED=false
# Strict global default: ads remain blocked until a Google-certified CMP is live.
VITE_ADSENSE_CMP_STATUS=not_configured

# Reference for the reviewed Firestore rules release that opens only approved public fields.
VITE_PUBLIC_DATA_RULES_RELEASE_REFERENCE=
