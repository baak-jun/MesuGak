# Copy this file to a school-server-only location such as
# /etc/mesugak/kis-paper.env. Never commit the copied file.
MESUGAK_MARKET=KR
# Daily KR market analysis uses the Financial Services Commission public APIs.
DATA_GO_KR_SERVICE_KEY=
DATA_GO_KR_TIMEOUT_SECONDS=30
DATA_GO_KR_RETRIES=3
DATA_GO_KR_REQUEST_DELAY_SECONDS=0.05
MESUGAK_MAX_STOCKS=200
# Poll the public provider every three minutes from 13:00 through 23:59 KST
# on weekdays; the cron expression must cover the same hour range.
MESUGAK_PUBLIC_DATA_WATCH_START_HOUR=13
MESUGAK_PUBLIC_DATA_WATCH_END_HOUR=23
MESUGAK_PUBLIC_DATA_RETRY_MINUTES=30
# KIS credentials below are only for the administrator's virtual account.
# Optional override. The school-server default is functions/.env.
MESUGAK_ENV_FILE=
# Keep stock-analysis Firestore batches below the timeout-prone legacy size.
# Increase only after observing successful full-market commits on the server.
MESUGAK_ANALYSIS_WRITE_BATCH_SIZE=20
MESUGAK_FIRESTORE_COMMIT_RETRIES=3
MESUGAK_FIRESTORE_COMMIT_RETRY_SECONDS=2
# Daily cleanup scans several Firestore collections and is disabled by default.
# Enable only during an intentional maintenance run.
MESUGAK_ENABLE_RETENTION_CLEANUP=false
# Keep this equal to the KIS virtual account opening balance; it is the return baseline.
MESUGAK_INITIAL_CASH=100000000
MESUGAK_BUY_SCORE_MIN=65.0
MESUGAK_SCORE_EXIT_THRESHOLD=-15.0
MESUGAK_TRAILING_STOP_PCT=0.08
# Protect a remaining small gain after a 3% run-up retreats 2% from its high.
MESUGAK_PROFIT_LOCK_ACTIVATE_PCT=0.03
MESUGAK_PROFIT_LOCK_TRAILING_PCT=0.02
MESUGAK_PROFIT_LOCK_MIN_PNL_PCT=0.005
# Sell a position opened today when its live quote reaches 3% below its average buy price.
MESUGAK_SAME_DAY_STOP_LOSS_PCT=0.03
# A same-session exit cannot re-enter the same code until the next trading day.
MESUGAK_BLOCK_REENTRY_AFTER_EXIT=true
MESUGAK_POSITION_WEIGHT=0.10
MESUGAK_ROTATION_SCORE_GAP=10.0
MESUGAK_MAX_LIVE_CANDIDATES=10
MESUGAK_QUOTE_DELAY_SECONDS=1.1
MESUGAK_QUOTE_RETRIES=2
MESUGAK_QUOTE_RATE_LIMIT_BACKOFF_SECONDS=2.0
MESUGAK_POLL_INTERVAL_SECONDS=60
MESUGAK_REFRESH_REQUEST_LIMIT=5
MESUGAK_MARKET_START_TIME=09:00
MESUGAK_MARKET_END_TIME=15:35
KIS_PAPER_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_PAPER_TOKEN_CACHE=runtime/kis/token.json
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_CANO=
KIS_PAPER_ACNT_PRDT_CD=
KIS_PAPER_HTS_ID=

# KIS WebSocket contest runner (dry-run unless --execute is passed)
MESUGAK_REALTIME_MAX_WATCH=39
MESUGAK_UNTRADABLE_FILE=runtime/checkpoints/untradable_KR.json
MESUGAK_REALTIME_BUY_SCORE_MIN=60
# Private contest only: KIS candles, isolated candidate snapshot and shared API pacing.
MESUGAK_REALTIME_HISTORY_DIR=runtime/kis-history
MESUGAK_REALTIME_CANDIDATE_FILE=runtime/checkpoints/contest_candidates_KR.json
KIS_PAPER_RATE_STATE=runtime/kis_request_rate.sqlite3
MESUGAK_REALTIME_PARTIAL_DRAWDOWN_PCT=0.018
MESUGAK_REALTIME_PARTIAL_SELL_FRACTION=0.50
MESUGAK_REALTIME_FULL_DRAWDOWN_PCT=0.03
MESUGAK_REALTIME_HISTORY_DIR=runtime/realtime-history
MESUGAK_REALTIME_CANDIDATE_FILE=runtime/checkpoints/realtime_candidates_KR.json
KIS_PAPER_REQUEST_INTERVAL_SECONDS=2.0
MESUGAK_REALTIME_DISCOVERY_SECONDS=60
MESUGAK_REALTIME_REPORT_SECONDS=60
MESUGAK_REALTIME_ACCOUNT_SYNC_SECONDS=300
MESUGAK_REALTIME_ENTRY_CLOSE_TIME=15:15:00
MESUGAK_REALTIME_STATE_PATH=runtime/realtime_order_state.sqlite3
MESUGAK_REALTIME_EXECUTE=false
# MESUGAK_REALTIME_RECORD_DIR=runtime/realtime_bars

# Administrator-only KOSPI/KOSDAQ comparison. Use the KIS virtual-account experiment start date.
MESUGAK_PERFORMANCE_BASELINE_DATE=

# Gmail alerts for failed, stalled, or stale school-server refreshes.
# Use a Google app password, not the Gmail login password.
MESUGAK_GMAIL_USER=
MESUGAK_GMAIL_APP_PASSWORD=
MESUGAK_ALERT_EMAIL_TO=
MESUGAK_CONTEST_EMAIL_ENABLED=false
MESUGAK_ALERT_SUBJECT_PREFIX="[MesuGak school server]"
# A watcher result older than this is not trusted to suppress a stale alert.
MESUGAK_PUBLIC_WATCH_STALE_MINUTES=90
MESUGAK_ALERT_COOLDOWN_HOURS=12
# A weekday refresh is considered overdue after this KST time.
MESUGAK_MONITOR_EXPECTED_BY=23:30
# Alert when a running analysis checkpoint has not moved for this long.
MESUGAK_MONITOR_PROGRESS_STALE_MINUTES=90
