# Copy this file to a school-server-only location such as
# /etc/mesugak/kis-paper.env. Never commit the copied file.
MESUGAK_MARKET=KR
# Daily KR market analysis uses the Financial Services Commission public APIs.
DATA_GO_KR_SERVICE_KEY=
DATA_GO_KR_TIMEOUT_SECONDS=30
DATA_GO_KR_RETRIES=3
DATA_GO_KR_REQUEST_DELAY_SECONDS=0.05
# KIS credentials below are only for the administrator's virtual account.
# Optional override. The school-server default is functions/.env.
MESUGAK_ENV_FILE=
# Keep this equal to the KIS virtual account opening balance; it is the return baseline.
MESUGAK_INITIAL_CASH=100000000
MESUGAK_BUY_SCORE_MIN=65.0
MESUGAK_SCORE_EXIT_THRESHOLD=-15.0
MESUGAK_TRAILING_STOP_PCT=0.08
# Protect a remaining small gain after a 3% run-up retreats 2% from its high.
MESUGAK_PROFIT_LOCK_ACTIVATE_PCT=0.03
MESUGAK_PROFIT_LOCK_TRAILING_PCT=0.02
MESUGAK_PROFIT_LOCK_MIN_PNL_PCT=0.005
# Sell a position opened today when its live quote reaches 3% below its average buy price.
MESUGAK_SAME_DAY_STOP_LOSS_PCT=0.03
# A same-session exit cannot re-enter the same code until the next trading day.
MESUGAK_BLOCK_REENTRY_AFTER_EXIT=true
MESUGAK_POSITION_WEIGHT=0.10
MESUGAK_ROTATION_SCORE_GAP=10.0
MESUGAK_MAX_LIVE_CANDIDATES=10
MESUGAK_QUOTE_DELAY_SECONDS=1.1
MESUGAK_QUOTE_RETRIES=2
MESUGAK_QUOTE_RATE_LIMIT_BACKOFF_SECONDS=2.0
MESUGAK_POLL_INTERVAL_SECONDS=60
MESUGAK_REFRESH_REQUEST_LIMIT=5
MESUGAK_MARKET_START_TIME=09:00
MESUGAK_MARKET_END_TIME=15:35
KIS_PAPER_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_PAPER_TOKEN_CACHE=/home/2023112374/mesugak/v2/runtime/kis/token.json
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_CANO=
KIS_PAPER_ACNT_PRDT_CD=

# Administrator-only KOSPI/KOSDAQ comparison. Use the KIS virtual-account experiment start date.
MESUGAK_PERFORMANCE_BASELINE_DATE=

# Gmail alerts for failed, stalled, or stale school-server refreshes.
# Use a Google app password, not the Gmail login password.
MESUGAK_GMAIL_USER=
MESUGAK_GMAIL_APP_PASSWORD=
MESUGAK_ALERT_EMAIL_TO=
MESUGAK_ALERT_SUBJECT_PREFIX="[MesuGak school server]"
MESUGAK_ALERT_COOLDOWN_HOURS=12
# A weekday refresh is considered overdue after this KST time.
MESUGAK_MONITOR_EXPECTED_BY=23:30
# Alert when a running analysis checkpoint has not moved for this long.
MESUGAK_MONITOR_PROGRESS_STALE_MINUTES=90
