# Keep this file outside Git or in the ignored V2 root as `.env.server`.
# Paths may be absolute or relative to MESUGAK_V2_ROOT.
MESUGAK_V2_ROOT=/absolute/path/to/Mesugak_V2
MESUGAK_PYTHON_BIN=/absolute/path/to/venv/bin/python
MESUGAK_ENV_FILE=functions/.env
BOT_FIREBASE_CRED_PATH=/absolute/path/to/serviceAccountKey.json
MESUGAK_KR_MARKETS=KOSPI,KOSDAQ
